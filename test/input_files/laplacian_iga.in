# Materials
[Materials]
   [./TestMaterial]
      [./ThermalConductivity]
          model = 'constant'
          value = '1.0'
      [../Density]
         value = '1.0'
      [../SpecificHeat]
         model = 'constant'
         value = '1.0'
[]

# Options related to all Physics
[Physics]

   enabled_physics = 'HeatConduction PenaltyDirichlet'

   [./HeatConduction]
     material = 'TestMaterial'

   [../PenaltyDirichlet]
     penalty = 1e9
     pin_variable = 'u'
     pin_target = 1.5
     bc_ids = '1 2 3 4'
     nodal_sides = true
[]

[Variables]
   [./Temperature]
      names = 'u'
      fe_family = 'LAGRANGE'
      order = 'FIRST'
[]

# Mesh related options
[Mesh]
   [./Read]
      filename = './grids/geom_4.exo'
      constraint_filename = './grids/geom_4_extraction_op.m.gz'
[]

#Linear and nonlinear solver options
[linear-nonlinear-solver]
   max_nonlinear_iterations =  25
   max_linear_iterations = 2500
   relative_residual_tolerance = '1.0e-14'
   relative_step_tolerance = '1.0e-12'
   minimum_linear_tolerance = '1.0e-10'
[]

# Visualization options
[vis-options]
   output_vis = 'true'
   vis_output_file_prefix = 'laplacian_iga'
   output_format = 'xda exo'
[]

# Options for print info to the screen
[screen-options]
   system_name = 'GRINS-TEST'
   print_equation_system_info = 'true'
   print_mesh_info = 'true'
   print_log_info = 'true'
   solver_verbose = 'true'
   solver_quiet = 'false'
[]
